<PreferenceScreen xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="@string/data">

        <Preference
            app:key="importcsv"
            app:summary="@string/import_a_previous_backup_from_phone_stor"
            app:title="@string/import_label"
            app:useSimpleSummaryProvider="false" />

        <Preference
            app:key="exportcsv"
            app:summary="@string/export_to_phone_storage"
            app:title="@string/export"
            app:useSimpleSummaryProvider="false" />

        <Preference
            app:key="deletedata"
            app:summary="@string/delete_all_app_workout_data"
            app:title="@string/clear_data"
            app:useSimpleSummaryProvider="false" />

    </PreferenceCategory>

    <PreferenceCategory app:title="@string/webdav_settings">

        <SwitchPreference
            android:defaultValue="false"
            android:key="togglewebdav"
            android:title="@string/webdav_backup" />
        <Preference
            app:key="importwebdav"
            app:summary="@string/import_a_previous_backup_from_webdav_ser"
            app:title="@string/import_label"
            app:useSimpleSummaryProvider="false" />

        <Preference
            app:key="exportwebdav"
            app:summary="@string/export_to_webdav_server"
            app:title="@string/export"
            app:useSimpleSummaryProvider="false" />
        <EditTextPreference
            android:key="webdavurl"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/url"
            app:summary="http://example.com" />
        <EditTextPreference
            android:key="webdavusername"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/username"
            app:summary="" />
        <EditTextPreference
            android:key="webdavpassword"
            android:inputType="textPassword"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:title="@string/password" />

        <Preference
            android:key="webdavcheckconnection"
            android:summary="@string/test_webdav_configuration"
            android:title="@string/check_connection" />

        <SwitchPreference
            android:defaultValue="false"
            android:key="autowebdavbackup"
            android:summary="@string/periodically_export_workouts_to_your_web"
            android:title="@string/auto_export" />


    </PreferenceCategory>

    <PreferenceCategory app:title="@string/general">

<ListPreference
            app:defaultValue="system"
            app:entries="@array/theme_entries"
            app:entryValues="@array/theme_values"
            app:key="theme"
            app:title="@string/theme"
            app:useSimpleSummaryProvider="true" />

        <Preference
            app:key="github"
            app:summary="@string/contributions_are_always_welcome"
            app:title="@string/source_code"
            app:useSimpleSummaryProvider="false" />

<!--        <Preference-->
<!--            app:key="version"-->
<!--            app:summary="0.0.1"-->
<!--            app:title="Version"-->
<!--            app:useSimpleSummaryProvider="false" />-->

        <Preference
            app:key="donate"
            app:summary="@string/if_you_like_this_app_consider_donating"
            app:title="@string/donate"
            app:useSimpleSummaryProvider="false" />


        <Preference
            app:key="licence"
            app:summary="@string/gnu_general_public_licence_version_3"
            app:title="@string/licence"
            app:useSimpleSummaryProvider="false" />

<!--        <Preference-->
<!--            app:key="privacy_policy"-->
<!--            app:summary="Learn more about our privacy policy"-->
<!--            app:title="Privacy Policy"-->
<!--            app:useSimpleSummaryProvider="false" />-->


<!--        <Preference-->
<!--            app:key="contact_us"-->
<!--            app:summary="If you need to get in touch."-->
<!--            app:title="Contact Us"-->
<!--            app:useSimpleSummaryProvider="false" />-->

    </PreferenceCategory>

</PreferenceScreen>